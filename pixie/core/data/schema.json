{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product Database Schema",
  "type": "object",
  "properties": {
    "printers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "brand": { "type": "string" },
          "technology": { "type": "string" },
          "price_cents": { "type": "integer" },
          "price": { "type": "number" },
          "currency": { "type": "string" },
          "description": { "type": "string" },
          "has_wifi": { "type": "boolean" },
          "has_duplex": { "type": "boolean" },
          "has_color": { "type": "boolean" },
          "is_multifunction": { "type": "boolean" },
          "print_speed_ppm": { "type": "integer" },
          "resolution_dpi": { "type": "string" },
          "max_paper_size": { "type": "string" },
          "availability_status": { "type": "string" },
          "stock_level": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "brand", "technology", "price_cents"]
      }
    },
    "laptops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "brand": { "type": "string" },
          "price": { "type": "number" },
          "currency": { "type": "string" },
          "screen_size_inches": { "type": "number" },
          "processor": { "type": "string" },
          "ram_gb": { "type": "integer" },
          "storage_gb": { "type": "integer" },
          "storage_type": { "type": "string" },
          "battery_life_hours": { "type": "number" },
          "operating_system": { "type": "string" },
          "weight_kg": { "type": "number" },
          "has_touchscreen": { "type": "boolean" },
          "has_webcam": { "type": "boolean" },
          "graphics_card": { "type": "string" },
          "ports": { "type": "string" },
          "warranty_years": { "type": "integer" },
          "color": { "type": "string" },
          "availability_status": { "type": "string" },
          "stock_level": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "brand", "price"]
      }
    },
    "computers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "brand": { "type": "string" },
          "price": { "type": "number" },
          "currency": { "type": "string" },
          "processor": { "type": "string" },
          "ram_gb": { "type": "integer" },
          "storage_gb": { "type": "integer" },
          "storage_type": { "type": "string" },
          "motherboard": { "type": "string" },
          "power_supply_watts": { "type": "integer" },
          "case_type": { "type": "string" },
          "operating_system": { "type": "string" },
          "has_wifi": { "type": "boolean" },
          "has_bluetooth": { "type": "boolean" },
          "graphics_card": { "type": "string" },
          "cooling_system": { "type": "string" },
          "ports": { "type": "string" },
          "warranty_years": { "type": "integer" },
          "color": { "type": "string" },
          "availability_status": { "type": "string" },
          "stock_level": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "brand", "price"]
      }
    },
    "smartphones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "brand": { "type": "string" },
          "price": { "type": "number" },
          "currency": { "type": "string" },
          "screen_size_inches": { "type": "number" },
          "resolution": { "type": "string" },
          "processor": { "type": "string" },
          "ram_gb": { "type": "integer" },
          "storage_gb": { "type": "integer" },
          "battery_capacity_mah": { "type": "integer" },
          "operating_system": { "type": "string" },
