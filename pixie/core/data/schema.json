          "color": { "type": "string" },
          "availability_status": { "type": "string" },
          "stock_level": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "brand", "price"]
      }
    }
  },
  "required": ["printers", "laptops", "computers", "smartphones"]
}
