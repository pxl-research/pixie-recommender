FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    UV_LINK_MODE=copy

WORKDIR /app

# Dependency layer (maximale cache)
COPY pyproject.toml ./
COPY uv.lock ./
RUN uv sync --frozen

# Make uv venv the default python (optional - but uv run is preferred)
ENV PATH="/app/.venv/bin:$PATH"

# App code
COPY . .

CMD ["uv", "run", "uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
