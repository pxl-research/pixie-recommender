ENV=dev
PORT_API=8012

# Safe example env file. Copy to `.env.dev` locally before running the dev compose stack:
#   cp .env.example .env.dev

# Azure OpenAI configuration (required for Azure LLM usage)
# Your Azure OpenAI resource endpoint URL
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# Your Azure OpenAI API key
AZURE_OPENAI_KEY=your-api-key-here
# API version to use (check Azure docs for latest)
AZURE_OPENAI_API_VERSION=2024-02-01
# Deployment/model name in your Azure resource
AZURE_OPENAI_MODEL=gpt-4

# Search configuration
# Path to the printer data JSON file
PIXIE_PRINTER_DATA=pixie/core/data/printers.json
# Default number of results per page
PIXIE_DEFAULT_PAGE_SIZE=10

# Database Configuration
DATABASE_URL=postgresql://pixie_user:pixie_password@postgres:5432/pixie_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# Alternative database URLs for different environments:
# DATABASE_URL=postgresql://user:password@host:port/database
# DATABASE_URL=sqlite:///pixie_dev.db  # For local development/testing

