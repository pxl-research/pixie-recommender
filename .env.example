ENV=dev
PORT_API=8000

# Safe example env file. Copy to `.env.dev` locally before running the dev compose stack:
#   cp .env.example .env.dev

# Azure OpenAI configuration (set these for real Azure usage)
# AZURE_OPENAI_API_VERSION: e.g. "2024-10-01"
# AZURE_OPENAI_ENDPOINT: your resource endpoint, e.g. "https://my-openai.openai.azure.com/"
# AZURE_OPENAI_KEY: your API key
# AZURE_OPENAI_MODEL: the deployment name (e.g. "gpt-5-chat")

